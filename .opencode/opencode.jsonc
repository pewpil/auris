{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash",
  "default_agent": "build",
  "mcp": {
    "servers": {
      "kicad": {
        "type": "local",
        "command": ["bash", "-c", "exec \"$HOME/.local/bin/uvx\" --from mcp-server-kicad mcp-server-kicad"],
      },
    },
  },
}