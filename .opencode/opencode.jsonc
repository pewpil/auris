{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash",
  "default_agent": "build",
  "instructions": [
    ".opencode/concept.md",
    ".opencode/plan.md",
    ".opencode/instruction.md",
    ".opencode/man.md",
    ".opencode/coding.md",
  ],
  "provider": {
    "opencode-go": {
      "name": "OpenCode Go",
      "options": {
        "apiKey": "{file:opencode.key}",
      },
    },
  },
}
