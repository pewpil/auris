{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash",
  "default_agent": "build",
  "instructions": [
    ".opencode/concept.md",
    ".opencode/new.md",
    ".opencode/plan.md",
    ".opencode/instruction.md",
    ".opencode/man.md",
    ".opencode/coding.md",
  ],
  "mcp": {
    "kicad": {
      "type": "local",
      "command": ["mcp-server-kicad"],
      "enabled": true,
      "timeout": 120000,
    },
  },
  "provider": {
    "opencode-go": {
      "name": "OpenCode Go",
      "options": {
        "apiKey": "{file:opencode.key}",
      },
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "sk-d22e8b23e034942d-407cbf-d1780010",
      },
      "models": {
        "auto": { "name": "agy/gemini-3.7-flash-high" },
      },
    },
  },
}
