{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash",
  "default_agent": "build",
  "instructions": [
    ".opencode/concept.md",
    ".opencode/new.md",
    ".opencode/plan.md",
    ".opencode/instruction.md",
    ".opencode/man.md",
    ".opencode/coding.md",
  ],
  "mcp": {
    "kicad": {
      "type": "local",
      "command": ["mcp-server-kicad"],
      "enabled": true,
      "timeout": 120000,
    },
  },
}
