{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4-flash",
  "small_model": "opencode/deepseek-v4-flash",
  "default_agent": "build",
  "instructions": [
    ".opencode/context.md",
    ".opencode/concept.md",
    ".opencode/plan.md",
    ".opencode/instruction.md",
    ".opencode/man.md"
  ],
  "provider": {
    "opencode-go": {
      "name": "OpenCode Go",
      "options": {
        "apiKey": "{file:opencode.key}"
      }
    }
  }
}
